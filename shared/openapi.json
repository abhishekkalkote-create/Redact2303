            "title": "Jurisdiction State",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "org_type": {
            "title": "Org Type",
            "type": "string"
          },
          "plan": {
            "title": "Plan",
            "type": "string"
          },
          "plan_status": {
            "title": "Plan Status",
            "type": "string"
          },
          "settings": {
            "additionalProperties": true,
