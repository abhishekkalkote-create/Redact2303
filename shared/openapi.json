              "default_rule_pack_ids": [],
              "dual_approval_required": false,
              "export_defaults": {
                "annotated_pdf": false,
                "clean_pdf": true,
                "exemption_log": true
              },
              "features": {},
              "retention_days_exports": 2555,
              "retention_days_uploads": 90
